{
    "version": "2.0.0",

    "tasks": [
        {
            "label": "Compilar proyecto Java",
            "type": "process",
            "command": "javac",
            "args": [
                "-cp",
                "lib\\mssql-jdbc-13.6.0.jre11.jar",
                "-sourcepath",
                "src",
                "-d",
                "out",
                "src\\app\\backend\\Aplicacion.java",
                "src\\app\\backend\\pruebas\\ProductoServicePrueba.java",
                "src\\app\\backend\\pruebas\\UsuarioServicePrueba.java",
                "src\\app\\backend\\pruebas\\EmpleadoServicePrueba.java",
                "src\\app\\backend\\pruebas\\AutorizacionServicePrueba.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$javac"
        },

        {
            "label": "Ejecutar prueba Producto",
            "type": "process",
            "command": "java",
            "args": [
                "-cp",
                "out;lib\\mssql-jdbc-13.6.0.jre11.jar",
                "app.backend.pruebas.ProductoServicePrueba"
            ],
            "dependsOn": "Compilar proyecto Java",
            "problemMatcher": []
        },

        {
            "label": "Ejecutar prueba Usuario (HU-01 y HU-02)",
            "type": "process",
            "command": "java",
            "args": [
                "-cp",
                "out;lib\\mssql-jdbc-13.6.0.jre11.jar",
                "app.backend.pruebas.UsuarioServicePrueba"
            ],
            "dependsOn": "Compilar proyecto Java",
            "problemMatcher": []
        },

        {
            "label": "Ejecutar prueba Empleado (HU-03)",
            "type": "process",
            "command": "java",
            "args": [
                "-cp",
                "out;lib\\mssql-jdbc-13.6.0.jre11.jar",
                "app.backend.pruebas.EmpleadoServicePrueba"
            ],
            "dependsOn": "Compilar proyecto Java",
            "problemMatcher": []
        },

        {
            "label": "Ejecutar prueba Autorizacion (HU-04)",
            "type": "process",
            "command": "java",
            "args": [
                "-cp",
                "out;lib\\mssql-jdbc-13.6.0.jre11.jar",
                "app.backend.pruebas.AutorizacionServicePrueba"
            ],
            "dependsOn": "Compilar proyecto Java",
            "problemMatcher": []
        },

        {
            "label": "Ejecutar aplicación",
            "type": "process",
            "command": "java",
            "args": [
                "-cp",
                "out;lib\\mssql-jdbc-13.6.0.jre11.jar",
                "app.backend.Aplicacion"
            ],
            "dependsOn": "Compilar proyecto Java",
            "problemMatcher": []
        }
    ]
}
